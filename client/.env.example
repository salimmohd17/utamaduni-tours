# Local development can use Vite's /api proxy by leaving VITE_API_URL unset.
VITE_API_URL=http://localhost:5000/api

# --- EmailJS (browser-based email, no server needed) ---
# Get these from https://emailjs.com → Account → API Keys / Services / Templates
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
# Template ID for new booking notifications sent to admin:
VITE_EMAILJS_BOOKING_TEMPLATE=template_xxxxxxx
# Template ID for confirmation email sent to guest when admin confirms:
VITE_EMAILJS_CONFIRM_TEMPLATE=template_xxxxxxx
