# ============================================================
# Utamaduni Safaris – Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

PORT=5000
JWT_SECRET=utamaduni-kwale-2026-secret-key-change-in-prod

# --- PostgreSQL (optional locally, required on Render) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Email: Option A – Resend (preferred for Render/Vercel) ---
# Sign up free at https://resend.com and add a verified domain/email.
# If RESEND_API_KEY is set it takes priority over SMTP.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Utamaduni Safaris <bookings@yourdomain.com>

# --- Email: Option B – Gmail SMTP with App Password ---
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-char code.
# 4. Paste it into SMTP_PASS (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your-email@gmail.com
